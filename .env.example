# Configuração Google Sheets

# Caminho para o arquivo JSON da Service Account
GOOGLE_SERVICE_ACCOUNT_KEY=./credentials.json

# ID da planilha Google Sheets
GOOGLE_SPREADSHEET_ID=1SxvklFCDRERzwS9VDelawU783qOS79HRe33ipUvsWeE

# Intervalo de cache em milissegundos (padrão: 5 min = 300000)
SHEETS_CACHE_TTL=300000

# Login Gestor (acesso total ao dashboard)
GESTOR_USER=gestor
GESTOR_PASS=dac2025

# Login Operador (acesso a Entradas, Saídas e Gestão de Dados)
OPERATOR_USER=operador
OPERATOR_PASS=dac2025

# ── Evolution API (WhatsApp) ──
EVO_API_URL=https://api.evolution.sua-instancia.com
EVO_API_KEY=SUA_API_KEY_AQUI
EVO_INSTANCE_NAME=NOME_DA_INSTANCIA

# ── WhatsApp Daily Report ──
WHATSAPP_DAILY_ENABLED=true
WHATSAPP_SCHEDULE_HOUR=17
WHATSAPP_MORNING_ENABLED=true
WHATSAPP_MORNING_HOUR=8

# Porta do servidor
PORT=3000
